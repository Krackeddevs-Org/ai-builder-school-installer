{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base capability for the setup window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://krackeddevs.com/*" },
        { "url": "https://ar-raqmi.net/*" },
        { "url": "https://litellm.rapidscreen.io/*" },
        { "url": "https://code.visualstudio.com/*" },
        { "url": "https://brew.sh/*" },
        { "url": "https://git-scm.com/*" },
        { "url": "https://nodejs.org/*" },
        { "url": "https://kilo.ai/*" },
        { "url": "https://learn.theaibuilder.school/*" }
      ]
    }
  ]
}